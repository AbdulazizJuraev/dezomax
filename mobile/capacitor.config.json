{
  "appId": "uz.dezomax.app",
  "appName": "DezoMax",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "hostname": "dezomax.app"
  },
  "android": {
    "backgroundColor": "#07080c",
    "allowMixedContent": false
  },
  "plugins": {
    "SystemBars": {
      "style": "DARK",
      "insetsHandling": "disable"
    },
    "BackgroundRunner": {
      "label": "uz.dezomax.app.notify",
      "src": "runners/notify.js",
      "event": "checkNotifications",
      "repeat": true,
      "interval": 15,
      "autoStart": true
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_dezomax",
      "iconColor": "#0A93DC"
    }
  }
}
