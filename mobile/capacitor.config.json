{
  "appId": "uz.dezomax.app",
  "appName": "DezoMax",
  "webDir": "www",
  "server": {
    "url": "https://abdulazizjuraev.github.io/dezomax/",
    "errorPath": "offline.html",
    "androidScheme": "https",
    "cleartext": true
  },
  "android": {
    "backgroundColor": "#07080c",
    "allowMixedContent": true
  },
  "plugins": {
    "SystemBars": {
      "style": "DARK",
      "insetsHandling": "disable"
    },
    "BackgroundRunner": {
      "label": "uz.dezomax.app.notify",
      "src": "runners/notify.js",
      "event": "checkNotifications",
      "repeat": true,
      "interval": 15,
      "autoStart": true
    }
  }
}
