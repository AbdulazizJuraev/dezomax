<?xml version="1.0" encoding="utf-8"?>
<!-- DezoMax bosh ekran vidjeti — Tezkor tugmalar (DzxWidgets.java) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="8dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="0dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/wqOpen"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="0dp"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@mipmap/ic_launcher_round"
                android:contentDescription="Ochish" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:text="Ochish"
                android:textColor="#FFCBD5E1"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/wqSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_w_search"
                android:contentDescription="Qidiruv" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:text="Qidiruv"
                android:textColor="#FFCBD5E1"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/wqDownloads"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_w_download"
                android:contentDescription="Yuklangan" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:text="Yuklangan"
                android:textColor="#FFCBD5E1"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/wqFav"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_w_heart"
                android:contentDescription="Sevimli" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:text="Sevimli"
                android:textColor="#FFCBD5E1"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
