<?xml version="1.0" encoding="utf-8"?>
<!-- DezoMax bosh ekran vidjeti — Yangi kinolar (DzxWidgets.java) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="10dp">
    <LinearLayout
        android:id="@+id/wHead"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@mipmap/ic_launcher_round"
            android:contentDescription="@null" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:text="@string/w_new"
            android:textColor="#FFE8EDF5"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/wCell1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="0dp"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/wPoster1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_poster_empty"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/wTitle1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFE8EDF5"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/wCell2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="7dp"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/wPoster2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_poster_empty"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/wTitle2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFE8EDF5"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/wCell3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="7dp"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/wPoster3"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_poster_empty"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/wTitle3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFE8EDF5"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
