<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!-- @capacitor/background-runner kutubxonasi joylashuv ruxsatlarini o'zi bilan olib keladi,
         lekin DezoMax fon vazifasi (js/runners/notify.js) joylashuvni umuman ishlatmaydi —
         shuning uchun ularni yakuniy ilovadan olib tashlaymiz. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" tools:node="remove" />
    <!-- Reklama identifikatori (AD_ID) AdMob reklamasi uchun kerak — shuning uchun endi olib tashlanmaydi.
         Play Console → Ilova tarkibi: «Reklama bor» = Ha, «Reklama identifikatori» = Ha (Reklama/marketing). -->
    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Kinoni telefonga parallel yuklab olish (foydalanuvchi bosganda; ilova yopilsa ham davom etadi) -->
        <service
            android:name=".DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Bosh ekran vidjetlari (DzxWidgets.java). Admin ilovasida yo'q — src/admin/AndroidManifest.xml -->
        <receiver
            android:name=".WidgetNew"
            android:exported="false"
            android:label="@string/w_new">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_new_info" />
        </receiver>
        <receiver
            android:name=".WidgetContinue"
            android:exported="false"
            android:label="@string/w_continue">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_continue_info" />
        </receiver>
        <receiver
            android:name=".WidgetQuick"
            android:exported="false"
            android:label="@string/w_quick">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_quick_info" />
        </receiver>
        <receiver
            android:name=".WidgetAll"
            android:exported="false"
            android:label="@string/w_all">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_all_info" />
        </receiver>

        <!-- Televizorga ulash (Chromecast) -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="uz.dezomax.app.CastOptionsProvider" />

        <!-- AdMob ilova ID (build.gradle → manifestPlaceholders.admobAppId) -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Bildirishnomalar (admin ilovasidan yuboriladi) va ularni belgilangan vaqtda chiqarish -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- QR kod skanerlash (Televizorda ko'ring banneri) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Yuklab olish xizmati (bildirishnomada foiz) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
