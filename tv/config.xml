<?xml version="1.0" encoding="UTF-8"?>
<!-- DezoMax — Samsung Smart TV (Tizen) ilovasi.
     Ilova ichida sayt (dezomax.uz) televizor rejimida ochiladi: pult bilan boshqariladi (js/tvmode.js).
     Saytdagi har bir yangilanish televizorda ham darhol ko'rinadi — ilovani qayta o'rnatish shart emas. -->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://dezomax.uz/tv" version="1.0.0" viewmodes="maximized">
    <tizen:application id="DzxMaxTv1.DezoMax" package="DzxMaxTv1" required_version="2.3"/>
    <name>DezoMax</name>
    <description>O‘zbek kinolari, filmlar va seriallar onlayn</description>
    <author href="https://dezomax.uz">DezoMax</author>
    <icon src="icon.png"/>
    <content src="index.html"/>

    <feature name="http://tizen.org/feature/screen.size.all"/>
    <tizen:profile name="tv-samsung"/>

    <!-- internet va pult tugmalari (Play/Pause, ⏪, ⏩) -->
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>

    <access origin="*" subdomains="true"/>
    <tizen:allow-navigation>*</tizen:allow-navigation>

    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable"
                   encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
