# Browser security headers for the whole static site.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Kesh: JS/CSS sahifalarda ?v=<versiya> bilan ulanadi (tools/bump-version.js) — versiya o'zgarsa yangi manzil
/js/*
  Cache-Control: public, max-age=604800
/css/*
  Cache-Control: public, max-age=604800
# Rasmlar: 30 kun (2026-11-28). Admin almashtira oladigan posterlar (custom) — 7 kun, eskisi shu orada fonda yangilanadi
/images/*
  Cache-Control: public, max-age=2592000
/images/custom/*
  ! Cache-Control
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/images/w/custom__*
  ! Cache-Control
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/images/w/l/images__custom__*
  ! Cache-Control
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/_seo/*
  Cache-Control: public, max-age=300
/sw.js
  Cache-Control: no-cache
# Kinolar ro'yxati: har safar faqat tekshiriladi (o'zgarmagan bo'lsa 304 — bir necha bayt)
/js/data-site.js
  ! Cache-Control
  Cache-Control: no-cache
/js/data-desc.js
  ! Cache-Control
  Cache-Control: no-cache
/js/site-config.js
  ! Cache-Control
  Cache-Control: no-cache
/js/lang-videos.js
  ! Cache-Control
  Cache-Control: no-cache
/js/data-custom.js
  ! Cache-Control
  Cache-Control: no-cache
/js/data-home.js
  ! Cache-Control
  Cache-Control: no-cache
