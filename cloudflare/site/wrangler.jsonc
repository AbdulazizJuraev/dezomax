// dezomax.uz — Cloudflare Workers + static assets. Yuklash: .github/workflows/cf-site.yml (npx wrangler deploy)
{
  "name": "dezomax-site",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // dezomax.uz — sayt; www.dezomax.uz — worker.js uni dezomax.uz ga yo'naltiradi
  "routes": [
    { "pattern": "dezomax.uz/*", "zone_name": "dezomax.uz" },
    { "pattern": "www.dezomax.uz/*", "zone_name": "dezomax.uz" }
  ],
  "assets": {
    "directory": "../../_site",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    // 2026-11-20: Worker faqat sahifalar va maxsus manzillar uchun. Oddiy fayllar (js/css/rasm/data/media/promo) Worker'siz
    // to'g'ridan-to'g'ri beriladi — bepul tarifda ular cheklovsiz, kunlik 100 ming so'rov chegarasiga kirmaydi.
    "run_worker_first": ["/*", "!/js/*", "!/css/*", "!/images/*", "!/data/*", "!/media/*", "!/promo/*"]
  }
}
